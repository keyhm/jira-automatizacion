# ── Valores compartidos por el equipo (iguales para todos) ──────────────
# Dominio de tu sitio Jira (SIN https:// y SIN barra final)
# Ejemplo: si tu Jira es https://jloutsourcer-team.atlassian.net
# entonces JIRA_DOMAIN=jloutsourcer-team.atlassian.net
JIRA_DOMAIN=tu-dominio.atlassian.net

# Key del proyecto Jira donde se crean las tareas (ej: JS, QA, OPIN, etc.)
JIRA_PROJECT_KEY=TU_PROJECT_KEY

# ID del board de Jira Software (Agile) asociado al proyecto de arriba.
# Se ve en la URL cuando abres el tablero en Jira: .../jira/software/.../boards/<ID>
JIRA_BOARD_ID=2

# ── Valores personales (cada persona pone los SUYOS, no se comparten) ───
# Tu correo de Atlassian
JIRA_EMAIL=tu-correo@dominio.com

# Tu propio token con scopes, generado en:
# https://id.atlassian.com/manage-profile/security/api-tokens
# Ver la sección "Scopes del token requeridos" en el README para la lista completa.
JIRA_API_TOKEN=tu_token_aqui
